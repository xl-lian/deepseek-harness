{
  "description": "Protect the science-agent ledger, object store, private state, and installed verifier, and start the research loop on continue-research requests, under dsh tool names.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write|edit|bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/synced/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/synced/hooks/round_trigger.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
